# Copy to .env.local (which is git-ignored) and fill in from
# Supabase → Project Settings → API. Neither value is NEXT_PUBLIC_, so they are
# only ever read inside the Next.js Route Handlers and never shipped to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
