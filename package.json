{
  "name": "resale-finder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mts\"",
    "test:backend": "npm --prefix backend test",
    "test:integration": "node --test \"test/integration/*.test.mts\"",
    "test:all": "npm test && npm run test:backend && npm run test:integration",
    "postinstall": "cd backend && npm install --no-audit --no-fund"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
