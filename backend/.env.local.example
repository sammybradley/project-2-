# Copy this file to backend/.env.local (which git ignores) and fill in the two
# values from the Supabase dashboard: Project Settings → API Keys.
#
# Leave both unset (or delete .env.local) and the backend falls back to the
# in-memory store, which needs no setup.

SUPABASE_URL=https://your-project-ref.supabase.co
# The *secret* key (starts with sb_secret_), not the publishable/anon key. It is
# only ever read on the server. Older projects call it service_role; that
# works too, as SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
